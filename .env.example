# Application Configuration
BASE_URL=http://localhost:3000
PORT=3000

# MongoDB Configuration
# NOTE: If your MongoDB password or username contains special characters
# (such as @, :, /, ?, #, [, ]), they MUST be URL-encoded!
# Example: '@' becomes '%40', '#' becomes '%23', ':' becomes '%3A'.
MONGODB_URI=mongodb://admin:password123@localhost:27017/pramuka_db?authSource=admin
MONGODB_DATABASE=pramuka_db

# MongoDB Container Root Credentials (used by Docker Compose)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password123

# JWT Authentication Secret (must be secure random string, at least 32 characters)
JWT_SECRET=dummy_super_secret_jwt_key_at_least_32_characters_long

# MinIO Object Storage Configuration
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=pramuka
MINIO_PUBLIC_URL=http://127.0.0.1:9000/pramuka

# SMTP Email Configuration
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=dummy_email@example.com
EMAIL_SMTP_PASS=dummy_smtp_app_password
EMAIL_SMTP_SECURE=false
